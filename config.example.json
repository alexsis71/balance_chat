{
  "pipeline_root": "../pipeline",
  "metadata_manifest": "../pipeline/data/metadata/manifest.json",
  "logging": {
    "path": "logs/balance_chat.jsonl",
    "level": "INFO",
    "max_bytes": 10485760,
    "backup_count": 5
  },
  "api": {
    "api_key_env": ""
  },
  "context_store": {
    "type": "postgresql",
    "schema": "chat_rag",
    "use_pipeline_database_dsn": true
  },
  "result_memory": {
    "enabled": true,
    "retrieval_limit": 5,
    "max_chunk_chars": 4000,
    "max_total_chars": 12000,
    "ttl_s": 86400
  },
  "semantic_repair_shadow": {
    "enabled_env": "SEMANTIC_REPAIR_SHADOW_ENABLED",
    "profile": "context",
    "timeout_s": 12,
    "max_tokens": 512,
    "recent_turn_limit": 4,
    "recent_result_limit": 4
  }
}
