{
  "$defs": {
    "AnalysisIntent": {
      "additionalProperties": false,
      "properties": {
        "intent_id": {
          "title": "Intent Id",
          "type": "string"
        },
        "operation": {
          "$ref": "#/$defs/Operation"
        },
        "operands": {
          "items": {
            "$ref": "#/$defs/AnalysisOperand"
          },
          "minItems": 1,
          "title": "Operands",
          "type": "array"
        },
        "periods": {
          "items": {
            "$ref": "#/$defs/PeriodRef"
          },
          "title": "Periods",
          "type": "array"
        },
        "grouping": {
          "items": {
            "$ref": "#/$defs/GroupingSpec"
          },
          "title": "Grouping",
          "type": "array"
        },
        "grain": {
          "anyOf": [
            {
              "enum": [
                "day",
                "month",
                "quarter",
                "year",
                "total"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Grain"
        },
        "comparison": {
          "anyOf": [
            {
              "$ref": "#/$defs/ComparisonSpec"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "operation",
        "operands"
      ],
      "title": "AnalysisIntent",
      "type": "object"
    },
    "AnalysisOperand": {
      "additionalProperties": false,
      "properties": {
        "operand_id": {
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Operand Id",
          "type": "string"
        },
        "metric": {
          "title": "Metric",
          "type": "string"
        },
        "aggregate_type": {
          "default": "sum",
          "title": "Aggregate Type",
          "type": "string"
        },
        "entities": {
          "items": {
            "$ref": "#/$defs/OperandEntityRef"
          },
          "title": "Entities",
          "type": "array"
        },
        "periods": {
          "items": {
            "$ref": "#/$defs/PeriodRef"
          },
          "title": "Periods",
          "type": "array"
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        }
      },
      "required": [
        "operand_id",
        "metric"
      ],
      "title": "AnalysisOperand",
      "type": "object"
    },
    "CanonicalEntityRef": {
      "additionalProperties": false,
      "properties": {
        "entity_id": {
          "title": "Entity Id",
          "type": "string"
        },
        "entity_type": {
          "enum": [
            "balance",
            "article",
            "route",
            "geo_object",
            "geo_group",
            "organization"
          ],
          "title": "Entity Type",
          "type": "string"
        },
        "display_name": {
          "title": "Display Name",
          "type": "string"
        }
      },
      "required": [
        "entity_id",
        "entity_type",
        "display_name"
      ],
      "title": "CanonicalEntityRef",
      "type": "object"
    },
    "ComparisonSpec": {
      "additionalProperties": false,
      "properties": {
        "baseline_operand_id": {
          "title": "Baseline Operand Id",
          "type": "string"
        },
        "target_operand_id": {
          "title": "Target Operand Id",
          "type": "string"
        },
        "delta_direction": {
          "const": "target_minus_baseline",
          "default": "target_minus_baseline",
          "title": "Delta Direction",
          "type": "string"
        },
        "percent_base": {
          "const": "baseline",
          "default": "baseline",
          "title": "Percent Base",
          "type": "string"
        }
      },
      "required": [
        "baseline_operand_id",
        "target_operand_id"
      ],
      "title": "ComparisonSpec",
      "type": "object"
    },
    "FieldMutation": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "$ref": "#/$defs/MutationAction"
        },
        "value": {
          "default": null,
          "title": "Value"
        }
      },
      "required": [
        "action"
      ],
      "title": "FieldMutation",
      "type": "object"
    },
    "GroupingSpec": {
      "additionalProperties": false,
      "properties": {
        "dimension": {
          "enum": [
            "geo",
            "geo_group",
            "balance",
            "article",
            "source",
            "destination",
            "route",
            "period"
          ],
          "title": "Dimension",
          "type": "string"
        },
        "canonical_group_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Canonical Group Id"
        },
        "aggregate_type": {
          "default": "sum",
          "title": "Aggregate Type",
          "type": "string"
        }
      },
      "required": [
        "dimension"
      ],
      "title": "GroupingSpec",
      "type": "object"
    },
    "IntentPatch": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "anyOf": [
            {
              "$ref": "#/$defs/FieldMutation"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "operands": {
          "anyOf": [
            {
              "$ref": "#/$defs/FieldMutation"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "periods": {
          "anyOf": [
            {
              "$ref": "#/$defs/FieldMutation"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "grouping": {
          "anyOf": [
            {
              "$ref": "#/$defs/FieldMutation"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "grain": {
          "anyOf": [
            {
              "$ref": "#/$defs/FieldMutation"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "comparison": {
          "anyOf": [
            {
              "$ref": "#/$defs/FieldMutation"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "IntentPatch",
      "type": "object"
    },
    "MutationAction": {
      "enum": [
        "keep",
        "set",
        "add",
        "remove",
        "clear",
        "reference"
      ],
      "title": "MutationAction",
      "type": "string"
    },
    "OperandEntityRef": {
      "additionalProperties": false,
      "properties": {
        "role": {
          "enum": [
            "balance",
            "source",
            "destination",
            "route",
            "article",
            "subject"
          ],
          "title": "Role",
          "type": "string"
        },
        "entity": {
          "$ref": "#/$defs/CanonicalEntityRef"
        }
      },
      "required": [
        "role",
        "entity"
      ],
      "title": "OperandEntityRef",
      "type": "object"
    },
    "Operation": {
      "enum": [
        "show",
        "aggregate",
        "compare",
        "compare_periods",
        "group",
        "multi_step"
      ],
      "title": "Operation",
      "type": "string"
    },
    "PeriodRef": {
      "additionalProperties": false,
      "properties": {
        "date_from": {
          "format": "date",
          "title": "Date From",
          "type": "string"
        },
        "date_to": {
          "format": "date",
          "title": "Date To",
          "type": "string"
        },
        "label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Label"
        }
      },
      "required": [
        "date_from",
        "date_to"
      ],
      "title": "PeriodRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "turn_id": {
      "title": "Turn Id",
      "type": "string"
    },
    "replace_intent": {
      "anyOf": [
        {
          "$ref": "#/$defs/AnalysisIntent"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "patch": {
      "$ref": "#/$defs/IntentPatch"
    },
    "user_message": {
      "title": "User Message",
      "type": "string"
    },
    "normalized_message": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Normalized Message"
    }
  },
  "required": [
    "turn_id",
    "user_message"
  ],
  "title": "ContextMutation",
  "type": "object"
}
